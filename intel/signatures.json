 "sql_error_patterns": [
  "you have an error in your sql syntax",
  "warning: mysql_",
  "unclosed quotation mark after the character string",
  "quoted string not properly terminated",
  "pg::syntaxerror",
  "fatal: syntax error at or near",
  "sqlite3::sqlexception",
  "unrecognized token:",
  "ora-\\d{5}",
  "odbc.*driver.*error",
  "sql syntax.*mysql",
  "invalid query",
  "mysql_fetch",
  "psql: fatal"
 ],
 "secret_patterns": [
  {
   "name": "AWS Access Key",
   "re": "AKIA[0-9A-Z]{16}"
  },
  {
   "name": "Google API Key",
   "re": "AIza[0-9A-Za-z_-]{35}"
  },
  {
   "name": "Stripe Secret Key",
   "re": "(sk|rk)_live_[0-9a-zA-Z]{24}"
  },
  {
   "name": "Slack Token",
   "re": "xox[baprs]-[0-9A-Za-z-]{10,48}"
  },
  {
   "name": "GitHub Token",
   "re": "gh[pousr]_[0-9A-Za-z]{36}"
  },
  {
   "name": "JWT",
   "re": "eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
  },
  {
   "name": "Private Key Block",
   "re": "-----BEGIN (RSA|EC|OPENSSH|PGP|DSA)? ?PRIVATE KEY( BLOCK)?-----"
  },
  {
   "name": "Generic API Key Var",
   "re": "(api[_-]?key|apikey|auth[_-]?token|access[_-]?token|client[_-]?secret)[\\\"'\\\\s]{0,4}[:=][\\\"'\\\\s]{0,4}[A-Za-z0-9_\\\\-]{16,}"
  }
