{
  "waf_signatures": {
    "Cloudflare": {"headers": {"server": "cloudflare"}, "cookies": ["__cfduid", "__cf_bm"], "body": ["attention required! | cloudflare"]},
    "Akamai": {"headers": {"server": "akamai", "x-akamai-transformed": ""}, "body": ["access denied", "reference #"]},
    "Imperva/Incapsula": {"cookies": ["incap_ses", "visid_incap"], "body": ["request unsuccessful. incapsula"]},
    "Sucuri": {"headers": {"x-sucuri-id": "", "server": "sucuri"}, "cookies": ["sucuri_cloudproxy_uuid"], "body": ["sucuri website firewall"]},
    "AWS WAF": {"headers": {"x-amzn-requestid": "", "x-amzn-waf-action": ""}, "body": ["awswaf: "]},
    "ModSecurity": {"headers": {"server": "mod_security"} , "body": ["not acceptable! you have exceeded", "mod_security"]},
    "F5 BIG-IP ASM": {"cookies": ["ts=", "bigipserver"], "body": ["the requested url was rejected"]},
    "Barracuda": {"cookies": ["barra_counter_session"], "body": ["barracuda networks"]},
    "Wordfence": {"body": ["wordfence", "generated by wordfence"]},
    "Wallarm": {"headers": {"server": "wallarm"}},
    "Caddy-Security": {"headers": {"server": "caddy"}}
  },
  "tech_signatures": [
    {"name": "WordPress", "where": "body", "pattern": "wp-content"},
    {"name": "WordPress", "where": "path", "pattern": "/wp-json"},
    {"name": "Drupal", "where": "body", "pattern": "/misc/drupal.js"},
    {"name": "Joomla", "where": "body", "pattern": "/media/jui/"},
    {"name": "Magento", "where": "body", "pattern": "mage/" },
    {"name": "Shopify", "where": "body", "pattern": "cdn.shopify.com"},
    {"name": "Next.js", "where": "body", "pattern": "_next/static"},
    {"name": "React", "where": "body", "pattern": "data-reactroot"},
    {"name": "Vue.js", "where": "body", "pattern": "data-v-app"},
    {"name": "Angular", "where": "body", "pattern": "ng-version="},
    {"name": "Laravel", "where": "cookie", "pattern": "laravel_session"},
    {"name": "Laravel", "where": "cookie", "pattern": "xsrf-token"},
    {"name": "Django", "where": "body", "pattern": "csrfmiddlewaretoken"},
    {"name": "Ruby on Rails", "where": "cookie", "pattern": "_session_id"},
    {"name": "ASP.NET", "where": "body", "pattern": "__viewstate"},
    {"name": "Express", "where": "header", "pattern": "express"},
    {"name": "PHP", "where": "header", "pattern": "php"},
    {"name": "Python", "where": "header", "pattern": "python"},
    {"name": "Flask/Werkzeug", "where": "header", "pattern": "werkzeug"},
    {"name": "Tomcat", "where": "header", "pattern": "tomcat"},
    {"name": "Jenkins", "where": "header", "pattern": "jenkins"},
    {"name": "Grafana", "where": "header", "pattern": "grafana"},
    {"name": "Nginx", "where": "header", "pattern": "nginx"},
    {"name": "Apache", "where": "header", "pattern": "apache"},
    {"name": "IIS", "where": "header", "pattern": "microsoft-iis"},
    {"name": "Cloudflare CDN", "where": "header", "pattern": "cloudflare"}
  ],
  "sql_error_patterns": [
    "you have an error in your sql syntax",
    "warning: mysql_",
    "unclosed quotation mark after the character string",
    "quoted string not properly terminated",
    "pg::syntaxerror",
    "fatal: syntax error at or near",
    "sqlite3::sqlexception",
    "unrecognized token:",
    "ora-\\d{5}",
    "odbc.*driver.*error",
    "sql syntax.*mysql",
    "invalid query",
    "mysql_fetch",
    "psql: fatal"
  ],
  "secret_patterns": [
    {"name": "AWS Access Key", "re": "AKIA[0-9A-Z]{16}"},
    {"name": "Google API Key", "re": "AIza[0-9A-Za-z_-]{35}"},
    {"name": "Stripe Secret Key", "re": "(sk|rk)_live_[0-9a-zA-Z]{24}"},
    {"name": "Slack Token", "re": "xox[baprs]-[0-9A-Za-z-]{10,48}"},
    {"name": "GitHub Token", "re": "gh[pousr]_[0-9A-Za-z]{36}"},
    {"name": "JWT", "re": "eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"},
    {"name": "Private Key Block", "re": "-----BEGIN (RSA|EC|OPENSSH|PGP|DSA)? ?PRIVATE KEY( BLOCK)?-----"},
    {"name": "Generic API Key Var", "re": "(api[_-]?key|apikey|auth[_-]?token|access[_-]?token|client[_-]?secret)[\\\"'\\\\s]{0,4}[:=][\\\"'\\\\s]{0,4}[A-Za-z0-9_\\\\-]{16,}"}
  ]
}
